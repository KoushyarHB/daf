generator client {

  provider = "prisma-client-js"

}



datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}



enum VocabPos {

  noun

  verb

  adjective

  adverb

  phrase

  grammar

  other

}



enum LessonPageKind {

  word

  grammar

}

enum UserRole {
  user
  admin
  super_admin
}

model User {

  id           String   @id @default(cuid())

  email        String   @unique

  passwordHash String   @map("password_hash")

  name         String?

  role         UserRole @default(user)

  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()



  cards           Card[]
  decks           Deck[]
  deckPublishes   DeckPublish[] @relation("DeckPublishedBy")
  progress        UserCardProgress[]
  hiddenCards     UserCardHidden[]
  tagImports      UserTagImport[]
  tagsCreated     Tag[]

  @@map("users")
}

model Deck {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  name           String
  slug           String
  description    String?
  level          String    @default("A1")
  isSystem       Boolean   @default(false) @map("is_system")
  publishedAt    DateTime? @map("published_at") @db.Timestamptz()
  publishedTagId String?   @map("published_tag_id")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  publishedTag Tag?          @relation(fields: [publishedTagId], references: [id], onDelete: SetNull)
  cards        Card[]
  publishes    DeckPublish[]

  @@unique([userId, slug])
  @@index([userId])
  @@map("decks")
}

model DeckPublish {
  id            String   @id @default(cuid())
  sourceDeckId  String   @map("source_deck_id")
  publishedById String   @map("published_by_id")
  tagId         String   @map("tag_id")
  cardCount     Int      @map("card_count")
  publishedAt   DateTime @default(now()) @map("published_at") @db.Timestamptz()

  sourceDeck  Deck @relation(fields: [sourceDeckId], references: [id], onDelete: Cascade)
  publishedBy User @relation("DeckPublishedBy", fields: [publishedById], references: [id], onDelete: Cascade)
  tag         Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@index([sourceDeckId])
  @@map("deck_publishes")
}



model Card {
  id           String   @id
  userId       String   @map("user_id")
  deckId       String?  @map("deck_id")
  sourceCardId String?  @map("source_card_id")
  publishedFromCardId String? @map("published_from_card_id")
  head         String

  ipa          String?

  pos          VocabPos @default(other)

  pluralRule   String?  @map("plural_rule")

  pluralForm   String?  @map("plural_form")

  imagePath    String?  @map("image_path")

  audioPath    String?  @map("audio_path")

  lektion      Int?

  level        String   @default("A1")

  sortOrder    Int      @map("sort_order")

  grammarTable Json?    @map("grammar_table")

  createdAt    DateTime @map("created_at") @db.Timestamptz()

  updatedAt    DateTime @map("updated_at") @db.Timestamptz()



  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  deck       Deck?              @relation(fields: [deckId], references: [id], onDelete: SetNull)
  sourceCard Card?              @relation("CardFork", fields: [sourceCardId], references: [id], onDelete: SetNull)
  forks      Card[]             @relation("CardFork")
  publishedFrom Card?           @relation("PublishedCopy", fields: [publishedFromCardId], references: [id], onDelete: SetNull)
  publishedCopies Card[]        @relation("PublishedCopy")
  glosses    CardGloss[]
  notes      CardNote[]
  examples   CardExample[]
  progress   UserCardProgress[]
  hiddenFrom UserCardHidden[]
  tags       CardTag[]

  @@index([userId])
  @@index([deckId])
  @@index([sourceCardId])
  @@index([publishedFromCardId])

  @@index([lektion])

  @@index([pos])

  @@index([level])

  @@index([sortOrder])

  @@map("cards")

}



model CardGloss {

  id        String @id @default(cuid())

  cardId    String @map("card_id")

  text      String

  sortOrder Int    @map("sort_order")

  card      Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)



  @@index([cardId])

  @@map("card_glosses")

}



model CardNote {

  id        String @id @default(cuid())

  cardId    String @map("card_id")

  text      String

  sortOrder Int    @map("sort_order")

  card      Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)



  @@index([cardId])

  @@map("card_notes")

}



model CardExample {

  id        String  @id @default(cuid())

  cardId    String  @map("card_id")

  german    String

  english   String?

  audioPath String? @map("audio_path")

  sortOrder Int     @map("sort_order")

  card      Card    @relation(fields: [cardId], references: [id], onDelete: Cascade)



  @@index([cardId])

  @@map("card_examples")

}



model Lesson {

  lektion Int          @id

  title   String

  pages   LessonPage[]



  @@map("lessons")

}



model LessonPage {

  id        String         @id @default(cuid())

  lessonId  Int            @map("lesson_id")

  kind      LessonPageKind

  label     String

  imagePath String         @map("image_path")

  lesson    Lesson         @relation(fields: [lessonId], references: [lektion], onDelete: Cascade)



  @@unique([lessonId, kind])

  @@map("lesson_pages")

}



model UserCardProgress {

  id        String    @id @default(cuid())

  userId    String    @map("user_id")

  cardId    String    @map("card_id")

  studied   Boolean   @default(true)

  studiedAt DateTime? @map("studied_at") @db.Timestamptz()

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  card      Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)



  @@unique([userId, cardId])

  @@index([userId])

  @@map("user_card_progress")
}

model UserCardHidden {
  userId   String   @map("user_id")
  cardId   String   @map("card_id")
  hiddenAt DateTime @default(now()) @map("hidden_at") @db.Timestamptz()
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  card     Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@id([userId, cardId])
  @@index([userId])
  @@map("user_card_hidden")
}

model Tag {
  id          String   @id @default(cuid())
  slug        String   @unique
  label       String
  isSystem    Boolean  @default(false) @map("is_system")
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  cards       CardTag[]
  userImports UserTagImport[]
  decks       Deck[]
  deckPublishes DeckPublish[]

  @@map("tags")
}

model CardTag {
  cardId String @map("card_id")
  tagId  String @map("tag_id")
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([cardId, tagId])
  @@index([tagId])
  @@map("card_tags")
}

model UserTagImport {
  userId     String   @map("user_id")
  tagId      String   @map("tag_id")
  importedAt DateTime @default(now()) @map("imported_at") @db.Timestamptz()
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([userId, tagId])
  @@index([userId])
  @@map("user_tag_imports")
}

